# Copy to ".env" (local) or set these as environment variables on your host.

# First moderator account (seeded on first run) — change before going live.
ADMIN_USER=moderator
ADMIN_PASS=change-this-to-a-strong-password

# --- Database ---
# Leave the Turso vars UNSET for local development: the app uses a local file
# (data/quietly.db) automatically — no account needed.
#
# For permanent hosting on a free tier (Render/Railway/etc.), create a free
# Turso database and paste its values here so data persists:
# TURSO_URL=libsql://your-db-name-yourorg.turso.io
# TURSO_AUTH_TOKEN=your-long-token

# PORT is set automatically by most hosts; override locally only if needed.
# PORT=3000
